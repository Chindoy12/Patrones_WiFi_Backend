DATABASE_URL=jdbc:postgresql://localhost:5432/wifisense
DATABASE_USERNAME=wifisense_app
DATABASE_PASSWORD=change-me
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=change-me-shared-with-ai-service
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=Change-Me1!
CORS_ALLOWED_ORIGINS=http://localhost:5173
MONITORING_ENABLED=true
# Only for a local demo: true allows simulated networks. Never set it in production.
DEMO_DATA_SOURCES=false
# Optional (defaults shown): access token, idle session, monitoring data kept, database connections
JWT_TTL=8h
SESSION_REFRESH_TTL=14d
MONITORING_RETENTION=90d
DATABASE_POOL_SIZE=10
# Recovery email (Brevo). Leave empty locally; MAIL_LOG_LINKS=true prints the link in the log instead.
BREVO_API_KEY=
MAIL_FROM=
FRONTEND_URL=http://localhost:5173
MAIL_LOG_LINKS=false
